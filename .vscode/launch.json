{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug bierkistnRadio",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/bierkistnRadio",
      "args": [],
      "cwd": "${workspaceFolder}",
      "environment": [
        { "name": "QT_QPA_PLATFORM", "value": "xcb" },
        { "name": "QT_LOGGING_RULES", "value": "qt.qpa.wayland.debug=true" }
      ],
      "MIMode": "gdb",
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "preLaunchTask": "Build"
    }
  ]
}
